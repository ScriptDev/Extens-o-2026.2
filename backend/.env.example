# ==============================================================================
# Backend Configuration (.env) - Agente de IA para Pregações
# ==============================================================================

# Database Connection (Supabase PostgreSQL)
# Exemplo Supabase: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:sua-senha-aqui@db.supabase.co:5432/postgres"

# Google Gemini API Credentials
# Obtenha em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="AIzaSy_SUA_CHAVE_GEMINI_AQUI"

# Gemini Model Selection (Padrão: gemini-1.5-pro, compatível com gemini-3.8-flash e gemini-2.5-pro)
GEMINI_MODEL="gemini-1.5-pro"

# Server Settings
APP_ENV="development"
PORT=8000
HOST="0.0.0.0"

# CORS Configuration (Origins autorizadas separadas por vírgula)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Upload Constraints (em Megabytes)
MAX_AUDIO_SIZE_MB=150

