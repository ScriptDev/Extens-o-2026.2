# ==============================================================================
# GUIA DE CONFIGURAÇÃO DE AMBIENTE: BACKEND (.env)
# Projeto: Agenda Teens & IA Multimodal para Pregações - Software Factory Labs
# ==============================================================================
# ⚠️ REGRA DE OURO DEVSECOPS:
# NUNCA versione o arquivo '.env' real no Git! Copie este arquivo para 'backend/.env'
# e insira as credenciais do seu ambiente de teste independente.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CONEXÃO COM O BANCO DE DADOS (PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
# O backend utiliza 'asyncpg' assíncrono para máxima performance.
# 
# OPÇÃO A: SUPABASE (Recomendado na nuvem)
# Obtenha no Dashboard do seu projeto Supabase:
# Settings -> Database -> Connection string -> URI
# - Formato Pooler (IPv4 / recomendado se sua rede não suportar IPv6):
#   DATABASE_URL="postgresql://postgres.[REF]:[SENHA]@aws-0-[REGIAO].pooler.supabase.com:6543/postgres?pgbouncer=true"
# - Formato Direto:
#   DATABASE_URL="postgresql://postgres:[SENHA]@db.[REF].supabase.co:5432/postgres?sslmode=require"
#
# OPÇÃO B: POSTGRESQL LOCAL (Docker ou Instalado na Máquina)
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agenda_teens_db"
#
DATABASE_URL="postgresql://postgres:sua-senha-aqui@db.supabase.co:5432/postgres"

# ------------------------------------------------------------------------------
# 2. INTELIGÊNCIA ARTIFICIAL: GOOGLE GEMINI API
# ------------------------------------------------------------------------------
# O sistema utiliza o Google Gemini (SDK google-genai) para:
# - Transcrição e esboço homilético de áudios/vídeos de cultos
# - Copiloto de criação de cultos com resolução temporal de datas
# - Gerador de convites litúrgicos para WhatsApp
# - Sugestão de ministérios e brasões teológicos em Kanji
#
# 🔑 Onde obter gratuitamente:
# Acesse https://aistudio.google.com/app/apikey com sua conta Google e crie sua chave.
GEMINI_API_KEY="AIzaSy_SUA_CHAVE_GEMINI_AQUI"

# Modelo selecionado (Padrão: gemini-2.5-flash para respostas ultra-rápidas, ou gemini-1.5-pro)
GEMINI_MODEL="gemini-2.5-flash"

# ------------------------------------------------------------------------------
# 3. SERVIDOR & REDE (FastAPI + Uvicorn)
# ------------------------------------------------------------------------------
APP_ENV="development"
PORT=8000
HOST="0.0.0.0"

# CORS: Origens permitidas para requisições web.
# Use '*' para desenvolvimento local ou liste os endereços separados por vírgula.
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000"

# Limite máximo de tamanho para upload de áudio/vídeo da pregação (em Megabytes)
MAX_AUDIO_SIZE_MB=150

# ==============================================================================
# 💡 COMO INICIALIZAR O BANCO APÓS PREENCHER SEU '.env':
# Execute o comando abaixo no terminal para criar tabelas e carregar os 7 usuários:
#   python backend/scripts/setup_complete_database.py
# ==============================================================================
