# ------------------------------------------------------------------------------
# 1. URL DA API FASTAPI (BACKEND)
# ------------------------------------------------------------------------------
# Endereço base onde o backend FastAPI está respondendo.
#
# Cenário 1: Teste no próprio computador (localhost)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Cenário 2: Teste PWA em Smartphone / Tablet na mesma rede Wi-Fi:
# Substitua pelo IP da sua máquina na rede local (ex: ipconfig no Windows):
# NEXT_PUBLIC_API_URL=http://192.168.1.15:8000
